# =====================================================
# SERVIDOR
# =====================================================

PORT=3000

# =====================================================
# POSTGRESQL
# =====================================================

# PostgreSQL local:
# postgres://postgres:TU_PASSWORD@127.0.0.1:5432/techsupply_outbound_demo
#
# Supabase:
# Utilizar la cadena suministrada en Supabase > Connect.
DATABASE_URL=

# false para PostgreSQL local.
# true para Supabase.
DB_SSL=false

# Reset seeders
ALLOW_DEMO_RESET=false

# =====================================================
# PYTHON / FASTAPI
# =====================================================

PYTHON_API=http://127.0.0.1:8000

# =====================================================
# AUTENTICACIÓN
# =====================================================

# Sustituir por una cadena larga y privada en el archivo .env real.
AUTH_SECRET=replace_with_a_long_random_secret

# =====================================================
# CONFIGURACIÓN TEMPORAL LOGÍSTICA
# =====================================================

APP_TIMEZONE=America/Guayaquil
HORA_INICIO_OPERACION=08:00
TIEMPO_SERVICIO_POR_ENTREGA_MIN=10
MARGEN_OPERATIVO_PORCENTAJE=15
MINUTOS_MAXIMOS_OPERACION_DIA=600
