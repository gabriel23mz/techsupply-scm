{
  "name": "techsupply-outbound",
  "version": "1.0.0",
  "description": "Sistema Outbound - TechSupply SCM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n NODE,PYTHON,FRONTEND -c green,cyan,magenta \"npm:dev:node\" \"npm:dev:python\" \"npm:dev:frontend\"",
    "dev:node": "nodemon server.js",
    "dev:python": "cd python && .venv\\Scripts\\python.exe -m uvicorn app:app --reload",
    "dev:frontend": "npm --prefix frontend run dev",

    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",

    "db:demo:clear": "node database/scripts/reset-demo.cjs",
    "db:demo:reset": "node database/scripts/reset-demo.cjs && npm run db:seed",

    "test": "npm run test:backend && npm run test:python && npm run test:frontend",
    "test:backend": "node --test \"tests/backend/**/*.test.js\"",
    "test:python": "cd python && .venv\\Scripts\\python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "test:frontend": "node --test \"tests/frontend/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.5",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "sequelize-cli": "^6.6.5"
  }
}
